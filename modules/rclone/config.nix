# modules/rclone/config.nix
{ config, lib, ... }:

let
  inherit (lib)
    concatStringsSep
    filterAttrs
    mapAttrsToList
    ;

  cfg = config.services.rclone;
  rcloneLib = import ../../lib { inherit lib; };

  # Collect all mounts that have union mode enabled
  unionMounts = filterAttrs (_: m: m.union.enable) cfg.mounts;

  # Build the INI body from all configured union mounts
  generatedConfigContent =
    let
      header = ''
        # Auto-generated by NixOS services.rclone module.
        # Direct edits will be overwritten across generations.
      '';
      sections = mapAttrsToList (name: m: rcloneLib.generateUnionSection name m.union) unionMounts;
    in
    header + "\n" + (concatStringsSep "\n" sections);

in
{
  config = lib.mkIf cfg.enable {
    # Expose generated config in /etc/rclone/
    environment.etc."rclone/rclone-generated.conf" = {
      text = generatedConfigContent;
      mode = "0644";
    };
  };
}
